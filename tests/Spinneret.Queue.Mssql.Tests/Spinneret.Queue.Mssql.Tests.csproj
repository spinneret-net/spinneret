<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spinneret.Queue.Mssql\Spinneret.Queue.Mssql.csproj" />
    <!-- The shared dialect adapter also registers the scheduler. -->
    <ProjectReference Include="..\..\src\Spinneret.Scheduler.Mssql\Spinneret.Scheduler.Mssql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spinneret.Testing\Spinneret.Testing.csproj" />
    <Using Include="Spinneret.Testing" />
  </ItemGroup>

  <!-- The queue conformance suites, compiled into this assembly so their commands are scanned from
       it and its InternalsVisibleTo grants cover them; QueueConformance.cs runs them on SQL Server. -->
  <ItemGroup>
    <Compile Include="..\Spinneret.Sql.Conformance\SqlTestDialect.cs" LinkBase="Conformance" />
    <Compile Include="..\Spinneret.Sql.Conformance\Dialects\MssqlTestDialect.cs" LinkBase="Conformance" />
    <Compile Include="..\Spinneret.Sql.Conformance\Queue\**\*.cs" LinkBase="Conformance\Queue" />
  </ItemGroup>

</Project>
