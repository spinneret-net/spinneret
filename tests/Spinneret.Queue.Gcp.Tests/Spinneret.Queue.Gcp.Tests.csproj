    <!-- Mints the test OIDC tokens the guarded endpoint is exercised with. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spinneret.Queue.Gcp\Spinneret.Queue.Gcp.csproj" />
  </ItemGroup>

</Project>
