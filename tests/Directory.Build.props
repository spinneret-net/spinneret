<Project>

  <!-- Chain to the repo root Directory.Build.props (nearest-file wins by default) -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The shared helper library is not itself a test application. Keyed on the project name
         because a property set in the project file is not yet visible when this file evaluates. -->
    <IsSharedTestSupport Condition="'$(MSBuildProjectName)' == 'Spinneret.Testing'">true</IsSharedTestSupport>
    <OutputType Condition="'$(IsSharedTestSupport)' != 'true'">Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <PackageReference Include="TUnit" Version="1.75.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
