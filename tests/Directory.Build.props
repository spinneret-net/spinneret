<Project>

  <!-- Chain to the root Directory.Build.props. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Keyed on the project name: project-file properties aren't visible yet here. -->
    <IsSharedTestSupport Condition="'$(MSBuildProjectName)' == 'Spinneret.Testing'">true</IsSharedTestSupport>
    <OutputType Condition="'$(IsSharedTestSupport)' != 'true'">Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSharedTestSupport)' != 'true'">
    <PackageReference Include="TUnit" Version="1.75.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
