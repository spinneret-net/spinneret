  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spinneret.Queue.Firestore\Spinneret.Queue.Firestore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Spinneret.Testing\Spinneret.Testing.csproj" />
    <Using Include="Spinneret.Testing" />
  </ItemGroup>

</Project>
