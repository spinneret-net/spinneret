<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- RS0041: the Razor source generator emits DynamicView.BuildRenderTree with
             nullability-oblivious parameters; our own code is fully annotated. -->
        <NoWarn>$(NoWarn);CS8524;RS0041</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Spinneret.ViewModel\Spinneret.ViewModel.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Blazor view layer: ViewBase components that resolve their view model from DI, with lifecycle state and app-wide refresh coordination.</Description>
        <PackageTags>$(PackageTags) blazor mvvm components views</PackageTags>
    </PropertyGroup>

</Project>
