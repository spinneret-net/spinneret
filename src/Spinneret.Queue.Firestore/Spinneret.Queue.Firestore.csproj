<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Cloud.Firestore" Version="4.3.0" />
        <!-- Configuration.Binder is where ConfigurationBinder.Bind lives, which is what the
             IConfiguration overload of AddFirestoreDeadLetters calls. -->
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <!-- The provider-agnostic queue only: a dead-letter store is orthogonal to the transport,
             so this composes with Cloud Tasks, SQL Server, or anything else implementing IQueue. -->
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Firestore-backed dead-letter store for Spinneret.Queue, usable behind any queue transport.</Description>
        <PackageTags>$(PackageTags) queue firestore dead-letter gcp google-cloud</PackageTags>
    </PropertyGroup>

</Project>
