<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql" Version="10.0.3" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Queue.Sql\Spinneret.Queue.Sql.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>PostgreSQL dialect for Spinneret.Queue.Sql: the queue's outbox and dead-letter tables in the application database, so an enqueue commits atomically with the business write that caused it.</Description>
        <PackageTags>$(PackageTags) queue postgres postgresql npgsql transactional background-jobs</PackageTags>
    </PropertyGroup>

</Project>
