<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Scheduler\Spinneret.Scheduler.csproj" />
        <ProjectReference Include="..\Spinneret.Queue.Sql\Spinneret.Queue.Sql.csproj" />
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- SqlSchedulerDialect and the registration helper: a dialect package supplies the
             statements and registers the scheduler through them. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Composition.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Relational scheduler for Spinneret over ADO.NET: durable recurring jobs and transactional one-shot jobs in the application database, dispatched onto the SQL queue in the same transaction. Pair it with a dialect package: Spinneret.Scheduler.Mssql or Spinneret.Scheduler.Postgres.</Description>
        <PackageTags>$(PackageTags) scheduler sql recurring-jobs transactional</PackageTags>
    </PropertyGroup>

</Project>
