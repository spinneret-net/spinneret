<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
        <!-- Configuration.Binder is where ConfigurationBinder.Bind lives, which is what the
             IConfiguration overloads of AddMssqlQueue call. -->
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>SQL Server transport for Spinneret.Queue: transactional enqueue and dequeue in the application database, with polling workers, retries and dead-lettering.</Description>
        <PackageTags>$(PackageTags) queue mssql sql-server transactional background-jobs</PackageTags>
    </PropertyGroup>

</Project>
