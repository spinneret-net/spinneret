<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
        <!-- SqlClient 7.1.1 still depends on a Pkcs with known advisories (GHSA-846f-f764-76mx). -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Queue.Sql\Spinneret.Queue.Sql.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>SQL Server dialect for Spinneret.Queue.Sql: the queue's outbox and dead-letter tables in the application database, so an enqueue commits atomically with the business write that caused it.</Description>
        <PackageTags>$(PackageTags) queue mssql sql-server transactional background-jobs</PackageTags>
    </PropertyGroup>

</Project>
