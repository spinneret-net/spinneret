<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- No ASP.NET Core framework reference, so a worker without a web stack can use this. -->
        <PackageReference Include="Google.Cloud.Firestore" Version="4.5.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Scheduler\Spinneret.Scheduler.csproj" />
        <!-- The transport-agnostic queue, so any IQueue the host registers works. -->
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Firestore-backed implementation of Spinneret.Scheduler with transactional dispatch, usable behind any queue transport.</Description>
        <PackageTags>$(PackageTags) scheduler firestore gcp google-cloud</PackageTags>
    </PropertyGroup>

</Project>
