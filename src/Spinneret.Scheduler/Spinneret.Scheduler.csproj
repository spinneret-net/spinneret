<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Cronos" Version="0.13.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
        <!-- IOptions/AddOptions/ValidateOnStart, used by AddSchedulerSweeper. Reaches us anyway
             through Hosting.Abstractions, but this package uses it directly. -->
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <!-- Unit appears in this package's public API, on IRecurringJob.CreateRequest(). -->
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Scheduler.Tests" />
        <!-- SchedulerTracing: the span shape is one contract shared by every storage provider, so the
             sweeps must not drift apart on names or tags. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Recurring jobs declared in code on cron schedules, installed idempotently at startup and dispatched as mediator requests.</Description>
        <PackageTags>$(PackageTags) scheduler recurring-jobs cron background-jobs</PackageTags>
    </PropertyGroup>

</Project>
