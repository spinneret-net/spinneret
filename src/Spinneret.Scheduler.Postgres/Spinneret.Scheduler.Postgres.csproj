<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Scheduler\Spinneret.Scheduler.csproj" />
        <ProjectReference Include="..\Spinneret.Scheduler.Sql\Spinneret.Scheduler.Sql.csproj" />
        <ProjectReference Include="..\Spinneret.Queue.Postgres\Spinneret.Queue.Postgres.csproj" />
        <ProjectReference Include="..\Spinneret.Queue.Sql\Spinneret.Queue.Sql.csproj" />
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>PostgreSQL dialect for Spinneret.Scheduler.Sql: durable recurring jobs and transactional one-shot jobs stored in the application database, dispatched onto the SQL queue in the same transaction.</Description>
        <PackageTags>$(PackageTags) scheduler postgres postgresql recurring-jobs transactional</PackageTags>
    </PropertyGroup>

</Project>
