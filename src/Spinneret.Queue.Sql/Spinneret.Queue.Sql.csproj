<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Sql.Tests" />
        <!-- SqlQueueDialect and SqlQueueStorage: a dialect package supplies the statements and the
             data source, and registers the storage through the internal registration helper. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <!-- The SQL scheduler dispatches inside the same unit of work as the queue it feeds, so it
             shares the storage, the unit of work and the command helpers. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Relational storage for Spinneret.Queue over ADO.NET: a transactional outbox in the application database, an in-host delivery worker, and dead letters. Pair it with a dialect package such as Spinneret.Queue.Mssql.</Description>
        <PackageTags>$(PackageTags) queue sql outbox transactional background-jobs</PackageTags>
    </PropertyGroup>

</Project>
