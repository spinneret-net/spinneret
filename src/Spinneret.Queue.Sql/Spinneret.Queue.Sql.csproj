<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Queue\Spinneret.Queue.csproj" />
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Dialect and scheduler packages share the internal storage, unit of work and command helpers. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Sql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Postgres" />
        <InternalsVisibleTo Include="Spinneret.Queue.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Composition.Tests" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Relational storage for Spinneret.Queue over ADO.NET: a transactional outbox in the application database, an in-host delivery worker, and dead letters. Pair it with a dialect package: Spinneret.Queue.Mssql or Spinneret.Queue.Postgres.</Description>
        <PackageTags>$(PackageTags) queue sql outbox transactional background-jobs</PackageTags>
    </PropertyGroup>

</Project>
