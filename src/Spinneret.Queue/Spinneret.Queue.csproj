<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Tests" />
        <!-- AddQueueCore: provider suites compose the core around test doubles AddQueue refuses. -->
        <InternalsVisibleTo Include="Spinneret.Queue.CloudTasks.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore.Tests" />
        <!-- ResolvedRequestEnqueuer. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql" />
        <!-- DeadLetterStorage and DeadLetterCursor: one contract for every dead-letter store. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore" />
        <!-- Unit of work, delivery pipeline and envelope factory. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Sql" />
        <!-- QueueTracing: producer and consumer share one trace-context contract. -->
        <InternalsVisibleTo Include="Spinneret.Queue.CloudTasks" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Durable command queue abstractions where the application owns the retry policy per command type: attempts, backoff, channels, dead-lettering.</Description>
        <PackageTags>$(PackageTags) queue background-jobs retry dead-letter</PackageTags>
    </PropertyGroup>

</Project>
