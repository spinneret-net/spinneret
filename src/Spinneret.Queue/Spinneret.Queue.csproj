<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Tests" />
        <!-- AddQueueCore: provider suites compose the core around recording doubles (an IQueue that
             only records), which AddQueue rightly refuses. -->
        <InternalsVisibleTo Include="Spinneret.Queue.CloudTasks.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql.Tests" />
        <InternalsVisibleTo Include="Spinneret.Queue.Postgres.Tests" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore.Tests" />
        <!-- ResolvedRequestEnqueuer: the scheduler sweeps enqueue requests they read back from a
             store, so their response type is only known at runtime. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Sql" />
        <!-- DeadLetterStorage and DeadLetterCursor: the source spelling and the cursor encoding are
             one contract shared by every dead-letter store, not a per-provider decision. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore" />
        <!-- The unit-of-work seam, the delivery pipeline and the envelope factory: the SQL storage
             supplies the transaction a delivery runs in and builds envelopes the same way the
             transports do. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Sql" />
        <!-- QueueTracing: the consumer parses back exactly what the producer wrote, so publishing a
             span and stamping trace context is one shared contract, not a per-transport decision. -->
        <InternalsVisibleTo Include="Spinneret.Queue.CloudTasks" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Durable command queue abstractions where the application owns the retry policy per command type: attempts, backoff, channels, dead-lettering.</Description>
        <PackageTags>$(PackageTags) queue background-jobs retry dead-letter</PackageTags>
    </PropertyGroup>

</Project>
