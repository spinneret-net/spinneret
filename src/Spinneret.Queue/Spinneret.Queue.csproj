<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <NoWarn>$(NoWarn);CS8524</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Spinneret.Mediator\Spinneret.Mediator.csproj" />
        <ProjectReference Include="..\Spinneret.Functional\Spinneret.Functional.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Spinneret.Queue.Tests" />
        <!-- ResolvedRequestEnqueuer: the scheduler sweeps enqueue requests they read back from a
             store, so their response type is only known at runtime. -->
        <InternalsVisibleTo Include="Spinneret.Scheduler.Firestore" />
        <InternalsVisibleTo Include="Spinneret.Scheduler.Mssql" />
        <!-- DeadLetterStorage and DeadLetterCursor: the source spelling and the cursor encoding are
             one contract shared by every dead-letter store, not a per-provider decision.
             IQueueTransactionScope additionally lets the MSSQL store make a resend atomic. -->
        <InternalsVisibleTo Include="Spinneret.Queue.Firestore" />
        <InternalsVisibleTo Include="Spinneret.Queue.Mssql" />
    </ItemGroup>

    <PropertyGroup>
        <Description>Durable command queue abstractions where the application owns the retry policy per command type: attempts, backoff, channels, dead-lettering.</Description>
        <PackageTags>$(PackageTags) queue background-jobs retry dead-letter</PackageTags>
    </PropertyGroup>

</Project>
